<launch>
  <arg name="world" default="nubot_world.sdf" />

  <gz_server
      world_sdf_file="$(var world)"
      world_sdf_string=""
      container_name="gazebo"
      create_own_container="True"
      use_composition="True" />

  <executable cmd="gz sim -g" />

  <ros_gz_bridge
      bridge_name="bridge"
      config_file="$(find-pkg-share nubot)/launch/bridge.yaml"
      container_name="gazebo"
      use_composition="True"
      create_own_container="False" />

</launch>
